{
  "name": "comitor-ai-usage",
  "version": "0.1.4",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "private": true,
  "type": "module",
  "description": "Comitor AI Usage — quản lý key hãng, mã nội bộ và nhật ký token cho team.",
  "scripts": {
    "dev": "next dev --port 3050",
    "build": "prisma generate && next build",
    "start": "next start --port 3050",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "i18n:check": "tsx scripts/check-messages.ts",
    "core:check": "tsx scripts/check-core-strings.ts",
    "tenant:check": "tsx scripts/check-tenant-scope.ts",
    "api:check": "tsx scripts/check-api-guards.ts",
    "color:check": "tsx scripts/check-colors.ts",
    "version:check": "tsx scripts/check-version.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "SHADOW=\"$(node -e 'const fs=require(\"fs\");let v=process.env.SHADOW_DATABASE_URL;if(!v&&fs.existsSync(\".env\")){try{process.loadEnvFile(\".env\")}catch{}v=process.env.SHADOW_DATABASE_URL}if(!v){console.error(\"db:check: thiếu SHADOW_DATABASE_URL — đặt biến môi trường, hoặc thêm dòng đó vào .env\");process.exit(1)}process.stdout.write(v)')\" && prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW\" --exit-code",
    "db:studio": "prisma studio",
    "catalog:prices": "tsx scripts/sync-litellm-prices.ts",
    "seed": "tsx --conditions=react-server --env-file=.env scripts/seed.ts",
    "job:due-soon": "tsx --conditions=react-server --env-file=.env scripts/jobs/due-soon-reminders.ts",
    "job:catalog-prices": "tsx scripts/jobs/catalog-prices.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm core:check && pnpm tenant:check && pnpm api:check && pnpm color:check && pnpm version:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@comitor/account-sdk": "^0.4.0",
    "@comitor/ui": "^1.10.0",
    "@prisma/client": "6.19.3",
    "@uppy/core": "^6.0.0",
    "@uppy/xhr-upload": "^6.0.0",
    "client-only": "^0.0.1",
    "date-fns": "4.4.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "nodemailer": "9.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
